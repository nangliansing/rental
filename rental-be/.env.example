# Runtime
NODE_ENV=development
PORT=3000
JSON_BODY_LIMIT=256kb
SHUTDOWN_TIMEOUT_MS=10000
SERVICE_NAME=rental-be
LOG_LEVEL=info

# Prometheus metrics. Production requires a random token of at least 32 characters.
METRICS_ENABLED=true
# METRICS_TOKEN=replace-with-a-random-metrics-token-at-least-32-characters

# Number of trusted reverse-proxy hops. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/rental

# Logical backup operations. Keep backup files outside source control.
BACKUP_DIRECTORY=backups
# RESTORE_MONGODB_URI=mongodb://127.0.0.1:27017/rental_restore_drill_YYYYMMDD
# Or derive a target on the MONGODB_URI deployment without exposing its URI.
# RESTORE_DRILL_DATABASE=rental_restore_drill_YYYYMMDD
# RESTORE_DRILL_CONFIRM=rental_restore_drill_YYYYMMDD

# Authentication: generate two different random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m

# Google Identity Services web client IDs. Use commas when multiple clients
# (for example web and mobile) are trusted by this backend.
GOOGLE_CLIENT_IDS=123456789-example.apps.googleusercontent.com

# Browser clients. Use comma-separated origins without paths or trailing slashes.
CORS_ORIGINS=http://localhost:5173

# Refresh-token cookie. Use none only with HTTPS in production.
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=.example.com

# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate limiting. Production requires redis and a REDIS_URL.
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://127.0.0.1:6379

# Background jobs (BullMQ). Disabled by default in development and test.
# Production defaults QUEUE_ENABLED=true and requires REDIS_URL.
QUEUE_ENABLED=false
# QUEUE_PREFIX=rental:queue
# WORKER_CONCURRENCY=5
# QUEUE_DEFAULT_ATTEMPTS=5
# QUEUE_BACKOFF_DELAY_MS=30000
# BUILDING_FOLLOWERS_NOTIFY_DEBOUNCE_MS=300000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_READ_MAX=180
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MUTATION_MAX=100
RATE_LIMIT_SENSITIVE_ACTION_MAX=20
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_ADMIN_MUTATION_MAX=100

# Reverse geocoding (Google Geocoding API).
# Use a SERVER key here, not the browser key from rental-fe VITE_GOOGLE_MAPS_API_KEY.
# In Google Cloud Console:
# 1. Enable "Geocoding API"
# 2. Create an API key restricted by IP (prod) or unrestricted/none (local dev only)
# 3. Do NOT use HTTP referrer restrictions on this key
GEOCODE_ENABLED=true
# GOOGLE_MAPS_API_KEY=your-server-google-maps-api-key
GEOCODE_CACHE_TTL_DAYS=30
RATE_LIMIT_GEOCODE_MAX=30

# Neighbourhood POI lookup (OpenStreetMap Overpass)
NEIGHBOURHOOD_OVERPASS_ENABLED=true
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NEIGHBOURHOOD_CACHE_TTL_DAYS=14
